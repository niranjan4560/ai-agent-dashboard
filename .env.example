# .env.example — copy to .env and fill in real values. Never commit .env.

# ── Core ──────────────────────────────────────────────────────────────────────
# "development" (default) or "production". Production refuses to start
# without SECRET_KEY and DATABASE_URL.
APP_ENV=development

# PostgreSQL connection string (Neon, Render, local…). postgres:// is accepted.
# Neon example: postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://username:password@localhost:5432/ai_dashboard

# Long random string used to sign login tokens, e.g. from:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change_me_to_a_long_random_string

# Login token lifetime in minutes (default 1440 = 24h)
JWT_EXPIRE_MINUTES=1440

# ── AI agent (required for ARIA chat) ─────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# Max ARIA messages per user per minute (protects your Gemini quota)
CHAT_RATE_LIMIT_PER_MINUTE=10

# ── Widgets ───────────────────────────────────────────────────────────────────
OPENWEATHER_API_KEY=your_openweathermap_api_key_here
NEWS_API_KEY=your_newsapi_org_key_here
# Default GitHub user shown in the widget (optional)
GITHUB_USERNAME=your_github_username_here
# Optional — raises GitHub rate limit from 60 to 5000 requests/hour
GITHUB_TOKEN=
# Crypto widget uses CoinGecko — no API key needed.

# ── Optional ──────────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API from another domain.
# Not needed when the UI is served by this app (the default).
CORS_ORIGINS=
LOG_LEVEL=INFO
